<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/cream_bg"
    android:paddingBottom="24dp">

    <!-- Photo Banner -->
    <ImageView
        android:id="@+id/ivDetailPhoto"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/photo_of_establishment"
        android:visibility="gone"
        tools:visibility="visible"
        tools:background="@color/steam" />

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:background="@color/steam" />

    <!-- Close Button -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="✕"
            android:textSize="16sp"
            android:textColor="@color/dark_coffee"
            android:background="@drawable/selector_nav_btn"
            android:padding="4dp" />

    </FrameLayout>

    <!-- Type Icon -->
    <TextView
        android:id="@+id/tvDetailTypeIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textSize="36sp"
        android:background="@drawable/circle_avatar" />

    <!-- Place Name -->
    <TextView
        android:id="@+id/tvDetailName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="24dp"
        android:gravity="center"
        android:textColor="@color/espresso"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Type + Open Status -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/tvDetailType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/muted_brown"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOpenStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginVertical="14dp"
        android:background="#D7CCC8" />

    <!-- Address -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="📍"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvDetailAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="@color/dark_coffee"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Rating -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="⭐"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvDetailRating"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="@color/dark_coffee"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Distance -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="24dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="🚶"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvDetailDistance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="@color/dark_coffee"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="24dp">

        <!-- Directions -->
        <LinearLayout
            android:id="@+id/btnDirections"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_button_light"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗺️"
                android:textSize="18sp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Directions"
                android:textColor="@color/espresso"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Bookmark -->
        <LinearLayout
            android:id="@+id/btnBookmark"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_button_light"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvBookmarkIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔖"
                android:textSize="18sp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvBookmarkLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save"
                android:textColor="@color/espresso"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>