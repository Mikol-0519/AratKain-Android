<?xml version="1.0" encoding="utf-8"?>
<!-- Profile screen with matching sidebar and clickable navigation -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/cream">

    <!-- ── Sidebar ─────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/espresso"
        android:paddingVertical="16dp"
        android:gravity="center_horizontal"
        android:elevation="8dp">

        <!-- Logo -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AK"
                android:textSize="14sp"
                android:textColor="@color/cream"
                android:fontFamily="serif"
                android:textStyle="bold" />

            <View
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="@color/latte"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <View
            android:layout_width="32dp"
            android:layout_height="1dp"
            android:background="@color/steam"
            android:layout_marginBottom="12dp" />

        <!-- Map button - navigates to Dashboard/Map -->
        <LinearLayout
            android:id="@+id/btnNavMap"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:background="@drawable/selector_nav_btn"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗺"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Bookmarks button - navigates to Favourites -->
        <LinearLayout
            android:id="@+id/btnNavBookmarks"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:background="@drawable/selector_nav_btn"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔖"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Profile (active) -->
        <LinearLayout
            android:id="@+id/btnNavProfile"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:background="@drawable/bg_nav_active"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤"
                android:textSize="18sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Logout button -->
        <LinearLayout
            android:id="@+id/btnLogout"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_logout_btn"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↪"
                android:textSize="16sp"
                android:textColor="@color/latte" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OUT"
                android:textSize="7sp"
                android:textColor="@color/latte"
                android:letterSpacing="0.05" />
        </LinearLayout>

    </LinearLayout>

    <!-- ── Main Content (Scrollable Profile) ─────────────────── -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@color/cream">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Avatar Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <!-- Avatar circle + camera badge -->
                <FrameLayout
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_marginBottom="12dp">

                    <!-- Initials fallback -->
                    <TextView
                        android:id="@+id/tvInitials"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:gravity="center"
                        android:textSize="28sp"
                        android:textColor="@color/latte"
                        android:textStyle="bold"
                        android:background="@drawable/circle_avatar" />

                    <!-- Actual photo -->
                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        app:civ_border_width="3dp"
                        app:civ_border_color="@color/steam"
                        android:visibility="gone" />

                    <!-- Camera badge -->
                    <ImageButton
                        android:id="@+id/ibChangePhoto"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="bottom|end"
                        android:padding="4dp"
                        android:background="@drawable/bg_camera_badge"
                        android:src="@drawable/ic_camera_alt"
                        android:contentDescription="Change profile photo"
                        android:elevation="4dp"
                        android:clickable="true"
                        android:focusable="true" />

                </FrameLayout>

                <!-- Upload progress indicator -->
                <ProgressBar
                    android:id="@+id/pbPhotoUpload"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvFullname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textColor="@color/espresso"
                    android:fontFamily="serif"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/latte"
                    android:layout_marginTop="1dp" />

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/muted"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Account Settings Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👤 "
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Account Settings"
                        android:textColor="@color/espresso"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="serif" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUpdateProfile"
                    style="@style/Widget.AratKain.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✏️   Edit Profile"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChangePassword"
                    style="@style/Widget.AratKain.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔒   Change Password"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>