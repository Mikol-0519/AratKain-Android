<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard: sidebar + full-screen map + bottom sheet -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- ── SIDEBAR (unchanged) ─────────────────────────────── -->
    <LinearLayout
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/espresso"
        android:paddingVertical="16dp"
        android:gravity="center_horizontal"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AK"
                android:textSize="14sp"
                android:textColor="@color/cream"
                android:fontFamily="serif"
                android:textStyle="bold" />
            <View
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="@color/accent"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <View android:layout_width="32dp" android:layout_height="1dp"
            android:background="#26C8A97E" android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/btnNavFood"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:background="@drawable/selector_nav_btn"
            android:layout_marginBottom="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🍽" android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnNavSaved"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:background="@drawable/selector_nav_btn"
            android:layout_marginBottom="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🔖" android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnNavProfile"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:background="@drawable/selector_nav_btn">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="👤" android:textSize="18sp" />
        </LinearLayout>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/btnLogout"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_logout_btn"
            android:layout_marginBottom="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="↪" android:textSize="16sp" android:textColor="@color/accent" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="OUT" android:textSize="7sp" android:textColor="@color/accent"
                android:letterSpacing="0.05" />
        </LinearLayout>

    </LinearLayout>

    <!-- ── MAIN CONTENT: Map + Overlays + Bottom Sheet ────────── -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <!-- Full-screen OSMDroid map -->
        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true" />

        <!-- Error banner (floats on top of map) -->
        <LinearLayout
            android:id="@+id/layoutError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="80dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/bg_error_banner"
            android:padding="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/error"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="@color/accent" />

        <!-- ── Top overlay: compact welcome card ── -->
        <LinearLayout
            android:id="@+id/cardWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:background="@drawable/bg_dashboard_card"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:layout_margin="10dp"
            android:elevation="6dp">

            <!-- Avatar -->
            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="10dp">
                <TextView
                    android:id="@+id/tvInitials"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:textColor="@color/latte"
                    android:textStyle="bold"
                    android:background="@drawable/circle_avatar" />
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    app:civ_border_width="2dp"
                    app:civ_border_color="@color/latte"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Name info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome back!"
                    android:textColor="@color/latte"
                    android:textSize="9sp" />
                <TextView
                    android:id="@+id/tvFullname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/cream"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="serif" />
                <TextView
                    android:id="@+id/tvUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#80C8A97E"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Profile icon button -->
            <LinearLayout
                android:id="@+id/btnViewProfile"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/selector_nav_btn">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙"
                    android:textColor="@color/latte"
                    android:textSize="16sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Re-center FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMyLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="104dp"
            android:contentDescription="My Location"
            app:backgroundTint="@color/espresso"
            app:tint="@color/accent"
            android:src="@android:drawable/ic_menu_compass"
            app:elevation="6dp"
            app:fabSize="mini" />

        <!-- ── Bottom Sheet ── -->
        <LinearLayout
            android:id="@+id/bottomSheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
            app:behavior_peekHeight="80dp"
            app:behavior_hideable="false">

            <!-- Drag handle -->
            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/steam"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp" />

            <!-- Nearby count + email row (peek content) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="10dp">

                <!-- Glowing dot -->
                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@color/accent"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nearby "
                    android:textColor="@color/espresso"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvNearbyCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/espresso"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="serif" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" spots"
                    android:textColor="@color/espresso"
                    android:textSize="12sp" />

                <!-- Spacer -->
                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

                <!-- Email (right-aligned, secondary info) -->
                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/steam" />

            <!-- Nearby places list — only visible when sheet is expanded -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNearbyPlaces"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingVertical="8dp"
                android:clipToPadding="false"
                android:overScrollMode="ifContentScrolls" />

        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</LinearLayout>